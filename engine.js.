
const STORAGE_KEY = "aviator_history";
let results = [];

try {
  const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
  if (Array.isArray(saved)) {
    results = saved.filter(x =>
      Number.isFinite(x) && x >= 1 && x <= 100000
    ).slice(0, 5000);
  }
} catch {
  results = [];
}

function saveResults() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(results));
}

function average(values) {
  return values.reduce((a,b) => a+b, 0) / values.length;
}

function median(values) {
  const sorted = [...values].sort((a,b) => a-b);
  const middle = Math.floor(sorted.length/2);
  return sorted.length % 2
    ? sorted[middle]
    : (sorted[middle-1]+sorted[middle])/2;
}

function addResult() {
  const input = document.getElementById("result");
  const value = Number(input.value);

  if (!Number.isFinite(value) || value < 1 || value > 100000) {
    alert("Enter a valid multiplier.");
    return;
  }

  results.unshift(Number(value.toFixed(2)));
  results = results.slice(0,5000);
  saveResults();
  input.value = "";
  update();
}

function importFile() {
  const file = document.getElementById("csvFile").files[0];

  if (!file) {
    alert("Choose a CSV or TXT file first.");
    return;
  }

  const reader = new FileReader();

  reader.onload = function() {
    const lines = String(reader.result).split(/\r?\n/);
    const imported = [];

    for (const line of lines) {
      const cell = line.split(",")[0].trim().replace(/x/gi,"");
      const value = Number(cell);

      if (cell && Number.isFinite(value) &&
          value >= 1 && value <= 100000) {
        imported.push(Number(value.toFixed(2)));
      }
    }

    if (!imported.length) {
      alert("No valid multipliers found. Use one multiplier per line.");
      return;
    }

    results = [...imported.reverse(), ...results].slice(0,5000);
    saveResults();
    update();

    alert(imported.length + " results imported.");
  };

  reader.readAsText(file);
}

function exportData() {
  if (!results.length) {
    alert("There are no results to export.");
    return;
  }

  const content = "multiplier\n" +
    results.map(x => x.toFixed(2)).join("\n");

  const blob = new Blob([content], {type:"text/csv"});
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");

  link.href = url;
  link.download = "laziq-round-history.csv";
  link.click();

  URL.revokeObjectURL(url);
}

function analyse() {
  if (results.length < 20) {
    document.getElementById("prediction").textContent = "--";
    document.getElementById("status").textContent =
      "Need at least 20 recorded rounds.";
    return;
  }

  const sample = results.slice(0,20);
  const estimate = median(sample);

  document.getElementById("prediction").textContent =
    estimate.toFixed(2) + "x";

  document.getElementById("status").textContent =
    "20-round historical median • Not a guaranteed forecast";
}

function drawChart() {
  const canvas = document.getElementById("multiplierChart");
  const ctx = canvas.getContext("2d");
  const width = canvas.width;
  const height = canvas.height;

  ctx.clearRect(0,0,width,height);

  ctx.strokeStyle = "#383838";
  ctx.fillStyle = "#999";
  ctx.font = "12px Arial";

  for (let i=0;i<=4;i++) {
    const y = height - i*height/4;
    ctx.beginPath();
    ctx.moveTo(35,y);
    ctx.lineTo(width,y);
    ctx.stroke();
  }

  const data = results.slice(0,30).reverse();

  if (!data.length) {
    ctx.fillText("Waiting for recorded rounds...",45,120);
    return;
  }

  const max = Math.max(5,...data);
  const gap = 5;
  const barWidth = (width-50)/data.length-gap;

  data.forEach((value,index) => {
    const barHeight = Math.max(3,(value/max)*(height-30));
    const x = 40+index*(barWidth+gap);
    const y = height-barHeight;

    ctx.fillStyle = value >= 10 ? "#ffbd4a" :
                    value >= 2 ? "#ff4141" : "#8b2929";

    ctx.fillRect(x,y,barWidth,barHeight);
  });
}

function update() {
  document.getElementById("count").textContent = results.length;

  if (!results.length) {
    document.getElementById("average").textContent = "--";
    document.getElementById("above").textContent = "0%";
    document.getElementById("history").innerHTML =
      "<li>No results recorded</li>";
    drawChart();
    return;
  }

  document.getElementById("average").textContent =
    average(results).toFixed(2)+"x";

  document.getElementById("above").textContent =
    (results.filter(x=>x>=2).length/results.length*100)
    .toFixed(1)+"%";

  const history = document.getElementById("history");
  history.replaceChildren();

  results.slice(0,20).forEach(value => {
    const item = document.createElement("li");
    item.textContent = value.toFixed(2)+"x";
    history.appendChild(item);
  });

  drawChart();
}

function clearData() {
  if (!confirm("Delete all recorded results?")) return;

  results = [];
  saveResults();

  document.getElementById("prediction").textContent = "--";
  document.getElementById("status").textContent =
    "ENGINE WAITING FOR DATA";

  update();
}

update();
